<UserControl x:Class="Restaurant.Wpf.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:Restaurant.Client.Core;assembly=Restaurant.Client.Core"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:LoginViewModel, IsDesignTimeCreatable=False}"
             Background="{DynamicResource WindowBgBrush}">

    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
        <Border Width="380" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="12" Padding="32">
            <StackPanel>
                <Border Width="48" Height="48" Background="{DynamicResource BrandPrimaryBrush}"
                        CornerRadius="8" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <TextBlock Text="🍽" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Đăng nhập" FontSize="18" FontWeight="Bold"
                           Foreground="{DynamicResource InkBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="Nhập tài khoản để bắt đầu ca làm việc" FontSize="12"
                           Foreground="{DynamicResource InkMutedBrush}" HorizontalAlignment="Center" Margin="0,4,0,24" />

                <TextBlock Text="TÀI KHOẢN" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource InkMutedBrush}" Margin="0,0,0,4" />
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource AppTextBoxStyle}" Margin="0,0,0,16" />

                <TextBlock Text="MẬT KHẨU" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource InkMutedBrush}" Margin="0,0,0,4" />
                <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource AppTextBoxStyle}" Margin="0,0,0,16" />

                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}"
                           FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsedConv}}" />

                <Button Content="Đăng nhập" Command="{Binding LoginCommand}"
                        Style="{StaticResource AppButtonStyle}" MinHeight="44" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
