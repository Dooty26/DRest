<UserControl x:Class="Restaurant.Wpf.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:Restaurant.Client.Core;assembly=Restaurant.Client.Core"
             xmlns:controls="clr-namespace:Restaurant.Wpf.Controls"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:ReportsViewModel, IsDesignTimeCreatable=False}"
             Background="{DynamicResource WindowBgBrush}">

    <Grid Margin="16">
        <StackPanel>
            <TextBlock Text="BÁO CÁO" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,16" />
            <controls:EmptyState Title="Báo cáo" Message="Tổng hợp doanh thu và số lượng đơn hàng." />
        </StackPanel>
    </Grid>
</UserControl>
