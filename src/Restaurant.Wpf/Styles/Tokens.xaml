<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- 5 Bắt buộc: Màu trạng thái bàn (docs/04 §2) -->
    <Color x:Key="StatusAvailableColor">#16A34A</Color>
    <Color x:Key="StatusAvailableBgColor">#DCFCE7</Color>
    <Color x:Key="StatusAvailableInkColor">#166534</Color>
    <SolidColorBrush x:Key="StatusAvailableBrush" Color="{StaticResource StatusAvailableColor}" />
    <SolidColorBrush x:Key="StatusAvailableBgBrush" Color="{StaticResource StatusAvailableBgColor}" />
    <SolidColorBrush x:Key="StatusAvailableInkBrush" Color="{StaticResource StatusAvailableInkColor}" />

    <Color x:Key="StatusReservedColor">#EAB308</Color>
    <Color x:Key="StatusReservedBgColor">#FEF9C3</Color>
    <Color x:Key="StatusReservedInkColor">#854D0E</Color>
    <SolidColorBrush x:Key="StatusReservedBrush" Color="{StaticResource StatusReservedColor}" />
    <SolidColorBrush x:Key="StatusReservedBgBrush" Color="{StaticResource StatusReservedBgColor}" />
    <SolidColorBrush x:Key="StatusReservedInkBrush" Color="{StaticResource StatusReservedInkColor}" />

    <Color x:Key="StatusOccupiedColor">#DC2626</Color>
    <Color x:Key="StatusOccupiedBgColor">#FEE2E2</Color>
    <Color x:Key="StatusOccupiedInkColor">#991B1B</Color>
    <SolidColorBrush x:Key="StatusOccupiedBrush" Color="{StaticResource StatusOccupiedColor}" />
    <SolidColorBrush x:Key="StatusOccupiedBgBrush" Color="{StaticResource StatusOccupiedBgColor}" />
    <SolidColorBrush x:Key="StatusOccupiedInkBrush" Color="{StaticResource StatusOccupiedInkColor}" />

    <Color x:Key="StatusCleaningColor">#6B7280</Color>
    <Color x:Key="StatusCleaningBgColor">#E5E7EB</Color>
    <Color x:Key="StatusCleaningInkColor">#374151</Color>
    <SolidColorBrush x:Key="StatusCleaningBrush" Color="{StaticResource StatusCleaningColor}" />
    <SolidColorBrush x:Key="StatusCleaningBgBrush" Color="{StaticResource StatusCleaningBgColor}" />
    <SolidColorBrush x:Key="StatusCleaningInkBrush" Color="{StaticResource StatusCleaningInkColor}" />

    <Color x:Key="StatusHeldColor">#7C3AED</Color>
    <Color x:Key="StatusHeldBgColor">#EDE9FE</Color>
    <Color x:Key="StatusHeldInkColor">#5B21B6</Color>
    <SolidColorBrush x:Key="StatusHeldBrush" Color="{StaticResource StatusHeldColor}" />
    <SolidColorBrush x:Key="StatusHeldBgBrush" Color="{StaticResource StatusHeldBgColor}" />
    <SolidColorBrush x:Key="StatusHeldInkBrush" Color="{StaticResource StatusHeldInkColor}" />

    <!-- Màu thương hiệu (Warm Amber / Terracotta) -->
    <Color x:Key="BrandPrimaryColor">#B45309</Color>
    <Color x:Key="BrandHoverColor">#92400E</Color>
    <Color x:Key="BrandLightColor">#FEF3C7</Color>
    <SolidColorBrush x:Key="BrandPrimaryBrush" Color="{StaticResource BrandPrimaryColor}" />
    <SolidColorBrush x:Key="BrandHoverBrush" Color="{StaticResource BrandHoverColor}" />
    <SolidColorBrush x:Key="BrandLightBrush" Color="{StaticResource BrandLightColor}" />
    <SolidColorBrush x:Key="BrandInkBrush" Color="#FFFFFF" />

    <!-- Bề mặt, Nền & Viền -->
    <SolidColorBrush x:Key="WindowBgBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceSubtleBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="BorderBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#CBD5E1" />

    <!-- Chữ (Ink) -->
    <SolidColorBrush x:Key="InkBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="InkMutedBrush" Color="#475569" />
    <SolidColorBrush x:Key="InkSubtleBrush" Color="#64748B" />
    <SolidColorBrush x:Key="InkInverseBrush" Color="#FFFFFF" />

    <!-- Cảnh báo & Nguy hiểm -->
    <SolidColorBrush x:Key="DangerBrush" Color="#DC2626" />
    <SolidColorBrush x:Key="DangerBgBrush" Color="#FEE2E2" />
    <SolidColorBrush x:Key="WarningBrush" Color="#D97706" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#16A34A" />

    <!-- Thông số kích thước & cảm ứng (>= 44px) -->
    <sys:Double x:Key="TouchTargetMin">44</sys:Double>
    <CornerRadius x:Key="CornerRadiusSm">4</CornerRadius>
    <CornerRadius x:Key="CornerRadiusMd">8</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLg">12</CornerRadius>
    <CornerRadius x:Key="CornerRadiusXl">16</CornerRadius>

    <!-- Font Family -->
    <FontFamily x:Key="AppFontFamily">Segoe UI, Helvetica, Arial, sans-serif</FontFamily>

</ResourceDictionary>
