<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Restaurant.Client.Core;assembly=Restaurant.Client.Core"
                    xmlns:views="clr-namespace:Restaurant.Wpf.Views"
                    xmlns:services="clr-namespace:Restaurant.Wpf.Services">

    <!-- Template Selector -->
    <services:ShellPageTemplateSelector x:Key="PageSelector" />

    <!-- Direct ViewModel Type Mappings -->
    <DataTemplate DataType="{x:Type vm:LoginViewModel}">
        <views:LoginView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:FloorPlanViewModel}">
        <views:FloorPlanView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:PosViewModel}">
        <views:PosView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:KitchenViewModel}">
        <views:KitchenView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
        <views:ReportsView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ReservationsViewModel}">
        <views:ReservationsView />
    </DataTemplate>

    <!-- Key-based String Templates for NavigateCommand("floor"|"pos"|"kitchen"|"reports") -->
    <DataTemplate x:Key="floorTemplate">
        <views:FloorPlanView />
    </DataTemplate>

    <DataTemplate x:Key="posTemplate">
        <views:PosView />
    </DataTemplate>

    <DataTemplate x:Key="kitchenTemplate">
        <views:KitchenView />
    </DataTemplate>

    <DataTemplate x:Key="reportsTemplate">
        <views:ReportsView />
    </DataTemplate>

    <DataTemplate x:Key="reservationsTemplate">
        <views:ReservationsView />
    </DataTemplate>

    <DataTemplate x:Key="loginTemplate">
        <views:LoginView />
    </DataTemplate>

</ResourceDictionary>
