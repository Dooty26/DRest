<UserControl x:Class="Restaurant.Wpf.Controls.TableTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:conv="clr-namespace:Restaurant.Wpf.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="120" d:DesignWidth="120">

    <UserControl.Resources>
        <conv:DisplayStatusToBrushConverter x:Key="StatusBrushConv" />
        <conv:DisplayStatusToBackgroundBrushConverter x:Key="StatusBgBrushConv" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisConv" />
    </UserControl.Resources>

    <Border x:Name="RootBorder"
            Background="{Binding DisplayStatus, Converter={StaticResource StatusBgBrushConv}}"
            BorderBrush="{Binding DisplayStatus, Converter={StaticResource StatusBrushConv}}"
            BorderThickness="2"
            CornerRadius="8"
            Padding="6"
            MinHeight="80"
            MinWidth="80">
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header: Tên bàn & Số ghế -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}"
                           FontWeight="Bold"
                           FontSize="14"
                           Foreground="{DynamicResource InkBrush}" />
                <TextBlock Grid.Column="1"
                           Text="{Binding Seats, StringFormat='{}{0} chỗ'}"
                           FontSize="11"
                           Foreground="{DynamicResource InkMutedBrush}" />
            </Grid>

            <!-- Subtitle thông tin khách / giờ / bill -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,4">
                <TextBlock Text="{Binding Subtitle}"
                           FontSize="11"
                           Foreground="{DynamicResource InkBrush}"
                           TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis"
                           MaxHeight="32" />
                <!-- Đếm ngược giữ bàn (nếu có hold) -->
                <Border Background="{DynamicResource StatusHeldBgBrush}"
                        BorderBrush="{DynamicResource StatusHeldBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="3,1"
                        Margin="0,4,0,0"
                        HorizontalAlignment="Left"
                        Visibility="{Binding HasHold, Converter={StaticResource BoolToVisConv}}">
                    <TextBlock Text="{Binding HoldRemainingText, StringFormat='⏳ {0}'}"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{DynamicResource StatusHeldInkBrush}" />
                </Border>
            </StackPanel>

            <!-- Footer: Nhãn trạng thái -->
            <Border Grid.Row="2"
                    Background="{Binding DisplayStatus, Converter={StaticResource StatusBrushConv}}"
                    CornerRadius="4"
                    Padding="4,2"
                    HorizontalAlignment="Stretch">
                <TextBlock Text="{Binding StatusLabel}"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center" />
            </Border>
        </Grid>
    </Border>
</UserControl>
