<UserControl x:Class="Restaurant.Wpf.Controls.StatusBadge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:conv="clr-namespace:Restaurant.Wpf.Converters"
             mc:Ignorable="d">
    <UserControl.Resources>
        <conv:DisplayStatusToBrushConverter x:Key="StatusBrushConv" />
        <conv:DisplayStatusToBackgroundBrushConverter x:Key="StatusBgBrushConv" />
    </UserControl.Resources>

    <Border Background="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DisplayStatus, Converter={StaticResource StatusBgBrushConv}}"
            BorderBrush="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DisplayStatus, Converter={StaticResource StatusBrushConv}}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="8,2"
            HorizontalAlignment="Left">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse Width="6" Height="6"
                     Fill="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DisplayStatus, Converter={StaticResource StatusBrushConv}}"
                     Margin="0,0,5,0" />
            <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=Text}"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource InkBrush}" />
        </StackPanel>
    </Border>
</UserControl>
