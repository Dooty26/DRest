{
  "name": "restaurant-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint src --ext .ts,.tsx --max-warnings 0 && npm run lint:copy",
    "lint:copy": "node ../scripts/check-ui-copy.mjs",
    "test": "vitest run",
    "gen:api": "openapi-typescript ../docs/openapi/openapi.v1.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@microsoft/signalr": "^8.0.7",
    "clsx": "^2.1.1",
    "lucide-react": "^0.460.0",
    "openapi-fetch": "^0.13.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.14.0",
    "@typescript-eslint/parser": "^8.14.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.14",
    "msw": "^2.6.4",
    "openapi-typescript": "^7.4.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}